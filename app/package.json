{
    "name": "ghosts",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
        "prettify": "prettier . --write",
        "preview": "vite preview",
        "test:motion": "node --experimental-strip-types --test tests/motion.test.ts tests/clearance.test.ts tests/armor-deformation.test.ts",
        "test:equipment": "node --experimental-strip-types --test tests/sidearm.test.ts",
        "test": "pnpm test:motion && pnpm test:equipment"
    },
    "dependencies": {
        "@ghosts/engine": "workspace:*",
        "@ghosts/squad": "workspace:*",
        "@mysten/dapp-kit-core": "^1.3.2",
        "@mysten/dapp-kit-react": "^2.0.3",
        "@mysten/enoki": "^1.0.8",
        "@mysten/sui": "^2.17.0",
        "@mysten/wallet-standard": "0.20.3",
        "@tailwindcss/vite": "^4.1.11",
        "@tanstack/react-query": "^5.83.0",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "react-router-dom": "^7.7.1",
        "three": "^0.174.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.32.0",
        "@types/react": "^19.1.8",
        "@types/react-dom": "^19.1.6",
        "@types/three": "^0.174.0",
        "@vitejs/plugin-react-swc": "^3.11.0",
        "eslint": "^9.32.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "globals": "^16.3.0",
        "prettier": "^3.6.2",
        "tailwindcss": "^4.1.11",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.38.0",
        "vite": "^6.3.5",
        "wrangler": "^4.151.2"
    },
    "packageManager": "pnpm@9.1.0"
}
