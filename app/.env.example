# Enoki public API key. zkLogin (Google) sign-in is hidden as unavailable without it.
VITE_ENOKI_API_KEY=
# Testnet faucet the app asks for SUI (Settings, and before a first write). Optional: the default is
# https://faucet.testnet.sui.io. A deploy that sets another host must also list it in connect-src
# in public/_headers.
VITE_FAUCET_URL=
