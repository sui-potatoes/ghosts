# Cloudflare response headers for the static assets. Vite copies this file into dist/.

# Hashed bundles: the name changes with the content, so cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Models, animation, textures and audio: unhashed, so a changed file needs a
# new name or a version query (the squad loaders use ?v=N). Thirty days.
/squad/*
  Cache-Control: public, max-age=2592000
/demo-assets/*
  Cache-Control: public, max-age=2592000
/sounds/*
  Cache-Control: public, max-age=2592000

# Documents: always revalidate so a deploy shows up on the next load.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/demo-runtime/index.html
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
